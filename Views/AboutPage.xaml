<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NikkeDiscordRPC.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="32,24,32,24">
            <StackPanel Spacing="24"
                        MaxWidth="760"
                        HorizontalAlignment="Center">
                <Border Padding="24"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Project Credits" 
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{ThemeResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Padding="24"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE77B;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Kisenaa"
                                           Style="{ThemeResource BodyLargeStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="Profile"
                                       Style="{ThemeResource BodyLargeStrongTextBlockStyle}" />
                            <HyperlinkButton Content="{x:Bind GithubProfileUrl, Mode=OneWay}"
                                             NavigateUri="{x:Bind GithubProfileUrl, Mode=OneWay}"
                                             HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Repository"
                                       Style="{ThemeResource BodyLargeStrongTextBlockStyle}" />
                            <HyperlinkButton Content="{x:Bind RepositoryUrl, Mode=OneWay}"
                                             NavigateUri="{x:Bind RepositoryUrl, Mode=OneWay}"
                                             HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
