<Page
    x:Class="NikkeDiscordRPC.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="*" />
            <ColumnDefinition x:Name="RightCol" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <StackPanel  Grid.Column="0"
                     Padding="30,40"
                     Spacing="24"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24"
                    CornerRadius="8">

                <StackPanel Spacing="24">
                    <ToggleSwitch Header="Use custom image"
                                  IsOn="{x:Bind ViewModel.UseCustomImage, Mode=TwoWay}" />

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.GameProvidedImageVisibility, Mode=OneWay}">
                        <TextBlock Text="Image Selection"
                                   Style="{StaticResource BodyLargeStrongTextBlockStyle}" />

                        <AutoSuggestBox x:Name="ImageSuggestBox"
                                        PlaceholderText="Search and select an image"
                                        HorizontalAlignment="Stretch"
                                        TextMemberPath="Name"
                                        Loaded="ImageSuggestBox_Loaded"
                                        TextChanged="ImageSuggestBox_TextChanged"
                                        SuggestionChosen="ImageSuggestBox_SuggestionChosen"
                                        QuerySubmitted="ImageSuggestBox_QuerySubmitted">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                    </StackPanel>

                    <StackPanel Spacing="14"
                                Visibility="{x:Bind ViewModel.CustomImageFieldsVisibility, Mode=OneWay}">
                        <TextBlock Text="Custom Discord App ID"
                                   Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
                        <TextBox PlaceholderText="Enter Discord Application ID"
                                 HorizontalAlignment="Stretch"
                                 Text="{x:Bind ViewModel.CustomDiscordApplicationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Custom Image Key"
                                   Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
                        <TextBox PlaceholderText="Enter Discord Image Key"
                                 HorizontalAlignment="Stretch"
                                 Text="{x:Bind ViewModel.CustomImageKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <TextBlock Text="Details"
                                   Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
                        <TextBox PlaceholderText="Enter Details (optional)"
                                 HorizontalAlignment="Stretch"
                                 Text="{x:Bind ViewModel.Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <TextBlock Text="State"
                                   Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
                        <TextBox PlaceholderText="Enter State (optional)"
                                 HorizontalAlignment="Stretch"
                                 Text="{x:Bind ViewModel.State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="300"
                                 />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Content="Start RPC"
                                Grid.Column="0"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,6,0"
                                FontWeight="Medium"
                                Command="{x:Bind ViewModel.StartRpcCommand}"/>

                        <Button Content="Stop RPC"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Margin="6,0,0,0"
                                Command="{x:Bind ViewModel.StopRpcCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- RIGHT PANEL -->
        <StackPanel Grid.Column="1"
            Padding="30,40"
            Spacing="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="24"
                    Width="320">

                <StackPanel Spacing="20">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Ellipse Width="96" Height="96" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Bind ViewModel.DiscordAvatarUrl, Mode=OneWay}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.DiscordUsername, Mode=OneWay}"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"/>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Border CornerRadius="4"
                                Padding="12,8"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.DiscordRunningVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" 
                                  FontFamily="Segoe Fluent Icons" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Discord Client Found"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" 
                                   FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="4"
                                Padding="12,8"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.DiscordNotRunningVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE711;" 
                                  FontFamily="Segoe Fluent Icons" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="Discord Client Not Found"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" 
                                   FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="4"
                                Padding="12,8"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.NikkeRunningVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" 
                                  FontFamily="Segoe Fluent Icons" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="NIKKE Game Found"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" 
                                   FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="4"
                                Padding="12,8"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.NikkeNotRunningVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE711;" 
                                  FontFamily="Segoe Fluent Icons" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="NIKKE Game Not Found"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" 
                                   FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,16"
                Padding="10,8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                Canvas.ZIndex="9"
                MaxWidth="490"
                Visibility="{x:Bind ViewModel.ProTipVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled"
                              Padding="0,0,0,4">
                    <StackPanel Spacing="8"
                                MinWidth="450">

                        <TextBlock Text="Pro tip"
                                   Style="{ThemeResource BodyLargeStrongTextBlockStyle}" />

                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F8;" FontSize="12" Opacity="0.7"/>
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="NoWrap">
                                    Minimize/maximize are in tray icon menu. Change the behavior in settings.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE765;" FontSize="12" Opacity="0.7"/>
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="NoWrap">
                                    <Run Text="Press "/>
                                    <Run Text="Ctrl + Shift + Alt + Q" FontWeight="SemiBold"/>
                                    <Run Text=" to bring app to foreground"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7E8;" FontSize="12" Opacity="0.7"/>
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="NoWrap">
                                    App auto-starts on boot by default
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" Opacity="0.7"/>
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="NoWrap">
                                    You can create a windows shorcut to launch nikke launcher and RPC
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Column="1"
                        Content="✕"
                        MinWidth="28"
                        MinHeight="28"
                        VerticalAlignment="Top"
                        Click="CloseProTipButton_Click" />
            </Grid>
        </Border>

        <Button HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,16"
                MinWidth="34"
                MinHeight="34"
                Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                Canvas.ZIndex="9"
                Visibility="{x:Bind ViewModel.ProTipExpandVisibility, Mode=OneWay}"
                Click="OpenProTipButton_Click"> 

            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE70E;"
                  FontFamily="Segoe Fluent Icons"
                  FontSize="14"/>
                <TextBlock Text="Open Tips"
                   FontWeight="SemiBold"/>
            </StackPanel>

        </Button>

        <InfoBar Grid.Row="1"
         x:Name="StatusInfoBar"
         VerticalAlignment="Bottom"
         Margin="32,0,0,20"
         IsClosable="True"
         CloseButtonClick="StatusInfoBar_CloseButtonClick"
         Canvas.ZIndex="10"
            >

            <InfoBar.Content>
                <TextBlock x:Name="StatusMessage" Margin="0,0,0,16" />
            </InfoBar.Content>

        </InfoBar>
    </Grid>
</Page>
